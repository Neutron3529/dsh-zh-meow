{
  "name": "@local/dsh-zh-meow",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "喵体中文 agent preset 系列：原版单体、管家、码农、独立校验者、可行性探针，以及可配置的团队设置页。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/index.js",
    "./plugin": "./plugin/index.js",
    "./plugin/index.js": "./plugin/index.js",
    "./plugin/locale/*": "./plugin/locale/*",
    "./team-config": "./plugin/team-config.js",
    "./delegate": "./plugin/delegate.js",
    "./cleanup": "./plugin/cleanup.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/"
  }
}
